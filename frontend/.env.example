# ==============================
# Fixora Properties - Frontend Environment Variables
# Copy to .env.local in this folder for local dev, or set these in Vercel's dashboard.
# ==============================

# The deployed backend's API base URL (include /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# This frontend's own public URL — used for metadata, sitemap.xml, robots.txt
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Maps — optional, not yet wired into any page ---
NEXT_PUBLIC_MAP_PROVIDER_KEY=
