# ==============================
# Fixora Properties - Backend Environment Variables
# Copy to .env in this folder.
# ==============================

# --- Core ---
NODE_ENV=development
PORT=4000

# --- Database ---
# Local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/fixora_dev
#
# MongoDB Atlas (replace with your own cluster's credentials — never commit real ones):
MONGODB_URI=mongodb+srv://your-atlas-username:your-atlas-password@your-cluster.mongodb.net/fixora

# --- Auth ---
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d# "localhost" for local dev. In production, LEAVE THIS EMPTY unless the
# frontend and backend share a parent domain (e.g. both under fixora.com) —
# a Render default URL (*.onrender.com) and a Vercel default URL
# (*.vercel.app) do NOT share one, and setting this to anything that isn't
# the backend's own host (or a true parent domain of it) makes the browser
# silently reject the cookie entirely. See docs/DEPLOYMENT.md.
COOKIE_DOMAIN=localhost

# --- Cache / Sessions (optional) ---
REDIS_URL=

# --- AI (OpenAI) — optional, feature disabled when unset ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- WhatsApp (Meta Cloud API) — optional, feature disabled when unset ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=

# --- Media storage (Cloudinary) — optional ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (Resend) — optional, logs the link instead when unset ---
RESEND_API_KEY=

# --- Observability — optional ---
SENTRY_DSN=

# --- CORS / cookies ---
# The deployed frontend's origin (Vercel URL or custom domain), used for the CORS allowlist
WEB_APP_URL=http://localhost:3000
